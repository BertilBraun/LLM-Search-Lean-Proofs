#!/usr/bin/env bash
# The stand-in for nvidia-smi's queries: --query-gpu prints index, MiB used and MiB total per GPU (the scenario's
# gpu_memory when present, else 1 of 24,576 MiB on four GPUs); --query-compute-apps the scenario's gpu_holders.
case "$1" in
    --query-gpu=*)
        if [[ -f "${FAKE_SCENARIO}/gpu_memory" ]]; then
            cat "${FAKE_SCENARIO}/gpu_memory"
        else
            printf '0, 1, 24576\n1, 1, 24576\n2, 1, 24576\n3, 1, 24576\n'
        fi
        ;;
    --query-compute-apps=*)
        cat "${FAKE_SCENARIO}/gpu_holders" 2>/dev/null
        ;;
    *)
        exit 2
        ;;
esac
exit 0
